              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();\r\nif (res.token) {\r\n    pm.environment.set(\"token\", res.token);\r\n}\r\n\r\npm.test(\"Статус 200\", () => pm.response.to.have.status(200));\r\npm.test(\"Время ответа < 2000 мс\", () => pm.expect(pm.response.responseTime).to.be.below(2000));\r\npm.test(\"Ответ содержит данные\", () => pm.expect(pm.response.text()).to.not.be.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"admin\",\r\n  \"password\": \"password123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
