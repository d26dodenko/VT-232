                  "    pm.expect(pm.response.responseTime).to.be.below(10000);",
                  "});",
                  "",
                  "pm.test(\"Тело содержит reason Bad credentials\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"Bad credentials\");",
                  "});"
